{
  "headers": [
    {
      "source": "/(signup|signup/account|signin|forgot-password|reset-password|onboarding|onboarding/telegram|office|ask|actions|departments|decisions)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/robots.txt", "destination": "/web/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/web/sitemap.xml" },
    { "source": "/signup", "destination": "/web/signup.html" },
    { "source": "/signup/account", "destination": "/web/signup-account.html" },
    { "source": "/signin", "destination": "/web/signin.html" },
    { "source": "/forgot-password", "destination": "/web/forgot-password.html" },
    { "source": "/reset-password", "destination": "/web/reset-password.html" },
    { "source": "/onboarding", "destination": "/web/onboarding.html" },
    { "source": "/onboarding/telegram", "destination": "/web/onboarding-telegram.html" },
    { "source": "/office", "destination": "/web/office.html" },
    { "source": "/ask", "destination": "/web/office.html" },
    { "source": "/actions", "destination": "/web/office.html" },
    { "source": "/departments", "destination": "/web/office.html" },
    { "source": "/decisions", "destination": "/web/office.html" },
    { "source": "/for-ceos", "destination": "/web/for-ceos.html" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/design-system.css", "destination": "/web/design-system.css" },
    { "source": "/onboarding-styles.css", "destination": "/web/onboarding-styles.css" },
    { "source": "/agba-logo.svg", "destination": "/web/agba-logo.svg" }
  ]
}